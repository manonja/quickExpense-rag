# .env.example
# Environment variables for QuickExpense RAG.
# Copy this file to .env and modify as needed for local development.
# These are automatically loaded by the settings module.

# --- Data Settings ---
# Directory to cache the downloaded database.
# Default: ~/.cache/quickexpense_rag
# QUICKEXPENSE_RAG_CACHE_DIR="/path/to/your/cache"

# URL to download the SQLite database from.
# Default: https://github.com/manonja/quickExpense-rag/releases/download/data-v2025.10/cra_rules.db
# QUICKEXPENSE_RAG_DB_DOWNLOAD_URL="https://your-mirror.com/cra_rules.db"

# Default filename for the downloaded database.
# Default: cra_rules.db
# QUICKEXPENSE_RAG_DB_FILENAME="my_custom_name.db"


# --- Embedding Settings ---
# SentenceTransformer model for embeddings.
# Default: BAAI/bge-small-en-v1.5
# QUICKEXPENSE_RAG_EMBEDDING_MODEL="BAAI/bge-base-en-v1.5"

# Device to run embedding model on ('cpu', 'cuda').
# Default: cpu
# QUICKEXPENSE_RAG_EMBEDDING_DEVICE="cuda"

# Batch size for embedding generation.
# Default: 32
# QUICKEXPENSE_RAG_EMBEDDING_BATCH_SIZE=64


# --- Search Settings ---
# Default number of search results to return.
# Default: 5
# QUICKEXPENSE_RAG_DEFAULT_TOP_K=10

# Reciprocal Rank Fusion constant 'k' to balance result sets.
# Default: 60
# QUICKEXPENSE_RAG_RRF_K=60


# --- Indexing Pipeline Settings (NOT used by the library runtime) ---
# These are only needed when running the scripts to build a new database.
# The library itself does not require a Gemini API key.
# This variable does not use the QUICKEXPENSE_RAG_ prefix as it is managed
# separately by the indexing scripts.
# GEMINI_API_KEY="your-google-ai-studio-api-key"
